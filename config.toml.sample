[app]
# Interface and port where the app will run its webserver.  The default value
# of localhost will only listen to connections from the current machine. To
# listen on all interfaces use '0.0.0.0'. To listen on the default web address
# port, use port 80 (this will require running with elevated permissions).
address = "localhost:9000"

# Database.
[db]
host = "localhost"
port = 5432
user = "listmonk"
password = "listmonk"

# Ensure that this database has been created in Postgres.
database = "listmonk"

ssl_mode = "disable"
max_open = 25
max_idle = 25

# Under auth_mode = "azure_managed_identity" this also bounds how long a
# connection outlives the token it was opened with. The token is validated when
# the connection is established, not per query, so a long-lived connection is
# not broken by its token expiring — but recycling well inside the token's
# roughly one-hour lifetime keeps that from being something to reason about.
# Setting 0 (unlimited) is what would make it worth thinking through.
max_lifetime = "300s"

# Optional space separated Postgres DSN params. eg: "application_name=listmonk gssencmode=disable"
params = ""

# How to authenticate to Postgres.
#   "password"               (default) uses the `password` field above.
#   "azure_managed_identity" presents a short-lived Microsoft Entra ID token
#                            instead, for an Azure Database for PostgreSQL
#                            server that has password authentication disabled.
#                            Leave `password` empty and set `user` to the
#                            database role bound to the identity.
#
# NOTE that "azure_managed_identity" additionally REQUIRES an ssl_mode of
# require, verify-ca or verify-full, and refuses to start otherwise. The token
# is the credential and travels as the DSN password, so an unencrypted
# connection would put a bearer token on the wire — replayable for its lifetime
# against a server that by definition accepts tokens. The `disable` default
# above is fine for a password on a trusted network and is not fine here.
auth_mode = "password"

# Client ID of a user-assigned managed identity to authenticate as. Leave empty
# to use the host's system-assigned identity. Applies to
# auth_mode = "azure_managed_identity" only.
azure_client_id = ""

# Authenticate through the broad DefaultAzureCredential chain rather than
# managed identity alone, so that a local `az login` works. For development
# only: the chain also honours ambient AZURE_* environment credentials, which
# would silently outrank the intended managed identity.
azure_use_default_credential_chain = false

[security]
# Turn off the username/password login routes entirely, leaving OIDC as the
# only way into the admin UI. The login page still renders, so that the SSO
# button remains reachable, but /admin/login POST, /admin/login/twofa,
# /admin/forgot and /admin/reset all return 404.
#
# Unlike the rest of the security settings, this one lives here rather than in
# the settings table, and so cannot be turned back on from the admin UI. That
# is the point of it: a kill switch an admin can undo is not one. Recovering
# from a broken identity provider means changing this and restarting.
#
# API tokens are unaffected — they authenticate on the Authorization header and
# do not go through these routes.
#
# The first-time setup page is exempt, since it is only reachable while no user
# exists at all and there would otherwise be no way to create the first one.
disable_password_login = false

[secrets]
# Credential fields elsewhere in listmonk — the SMTP password and the OIDC
# client secret — accept a REFERENCE instead of the secret itself:
#
#   akv:https://myvault.vault.azure.net/secrets/smtp-password
#   akv:https://myvault.vault.azure.net/secrets/smtp-password/<version>
#
# The reference is dereferenced in-process, at the moment the credential is
# used, by the identity listmonk runs as. Anything else that can read where the
# reference is stored — the settings table, a database backup, the container
# platform's configuration API — sees a URL rather than a credential.
#
# That matters because those settings live in a `settings` table stored as
# plain JSONB, so a literal secret there is captured by every backup of the
# database and stays there after the credential is rotated.
#
# A value with no `akv:` prefix is used exactly as given, so this changes
# nothing for an installation that does not use it, and no Azure credential is
# constructed unless a reference is actually resolved.

# Client ID of a user-assigned managed identity to dereference with. Empty
# falls back to AZURE_CLIENT_ID, and then to the host's system-assigned
# identity.
azure_client_id = ""

# Dereference through the broad DefaultAzureCredential chain rather than
# managed identity alone, so a local `az login` works. Development only: the
# chain also honours ambient AZURE_* environment credentials, which would
# silently outrank the intended managed identity.
azure_use_default_credential_chain = false
